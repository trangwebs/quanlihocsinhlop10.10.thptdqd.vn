        ];

        // Evenly distribute 45 students across 5 Groups (9 students per group)
        const defaultStudents = rawInitialData.map((item, index) => {
            const groupNum = (index % 5) + 1; 
            return {
                id: item.stt.toString(),
                name: item.name,
                gender: item.gender,
                dob: item.dob,
                ethnicity: item.ethnicity,
                school: item.school,
                score: item.score,
                group: `Tổ ${groupNum}`,
                role: 'Thành viên',
                academic: 'Chưa xếp loại',
                gpa: 0
            };
        });

        // App Data Storage
        let students = [];
        let weeklyGroupPoints = {}; // Stores group scores per week: { 'Tuần 1': {'Tổ 1': 100, ...} }
        let monthlyConducts = {};   // Stores student conduct per month: { 'Tháng 9': { 'id1': {score: 100, rating: 'Tốt'}, ... } }
        let attendanceRecords = {};

        window.onload = function() {
            loadTheme();
            initWeekSelector();
            initData();
            switchTab('dashboard');

            const today = new Date().toISOString().split('T')[0];
            document.getElementById('attendance-date').value = today;
            loadAttendanceForDate();
        };

        function initWeekSelector() {
            const select = document.getElementById('selected-week');
            let optionsHTML = '';
            for (let i = 1; i <= 35; i++) {
                optionsHTML += `<option value="Tuần ${i}">Tuần ${i}</option>`;
            }
            select.innerHTML = optionsHTML;
        }

        function initData() {
            // Load Students
            const storedStudents = localStorage.getItem('10_10_students_v2');
            if (storedStudents) {
                try { students = JSON.parse(storedStudents); } catch (e) { students = [...defaultStudents]; }
            } else {
                students = [...defaultStudents];
                saveStudentsToStorage();
            }

            // Load Weekly Group Points
            const storedWeekly = localStorage.getItem('10_10_weekly_points_v2');
            if (storedWeekly) {
                try { weeklyGroupPoints = JSON.parse(storedWeekly); } catch (e) { weeklyGroupPoints = {}; }
            }
            if (!weeklyGroupPoints['Tuần 1']) {
                weeklyGroupPoints['Tuần 1'] = { 'Tổ 1': 100, 'Tổ 2': 98, 'Tổ 3': 95, 'Tổ 4': 99, 'Tổ 5': 97 };
                saveWeeklyPointsToStorage();
            }

            // Load Monthly Conduct Records
            const storedConducts = localStorage.getItem('10_10_monthly_conducts_v2');
            if (storedConducts) {
                try { monthlyConducts = JSON.parse(storedConducts); } catch (e) { monthlyConducts = {}; }
            }

            // Load Attendance Records
            const storedAttendance = localStorage.getItem('10_10_attendance_v2');
            if (storedAttendance) {
                try { attendanceRecords = JSON.parse(storedAttendance); } catch (e) { attendanceRecords = {}; }
            }
        }

        function saveStudentsToStorage() {
            localStorage.setItem('10_10_students_v2', JSON.stringify(students));
        }

        function saveWeeklyPointsToStorage() {
            localStorage.setItem('10_10_weekly_points_v2', JSON.stringify(weeklyGroupPoints));
        }

        function saveMonthlyConductsToStorage() {
            localStorage.setItem('10_10_monthly_conducts_v2', JSON.stringify(monthlyConducts));
        }

        function saveAttendanceToStorage() {
            localStorage.setItem('10_10_attendance_v2', JSON.stringify(attendanceRecords));
        }

        function confirmResetData() {
            if (confirm('Khôi phục danh sách gốc 45 học sinh Lớp 10.10 chia đều 5 Tổ?')) {
                students = [...defaultStudents];
                weeklyGroupPoints = { 'Tuần 1': { 'Tổ 1': 100, 'Tổ 2': 98, 'Tổ 3': 95, 'Tổ 4': 99, 'Tổ 5': 97 } };
                monthlyConducts = {};
                saveStudentsToStorage();
                saveWeeklyPointsToStorage();
                saveMonthlyConductsToStorage();
                renderAll();
                showToast('Đã khôi phục dữ liệu gốc!');
            }
        }

        // Theme Switcher
        function toggleDarkMode() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('10_10_theme', isDark ? 'dark' : 'light');
            updateThemeIcons(isDark);
        }

        function loadTheme() {
            const savedTheme = localStorage.getItem('10_10_theme');
            const isDark = savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) document.documentElement.classList.add('dark');
            else document.documentElement.classList.remove('dark');
            updateThemeIcons(isDark);
        }

        function updateThemeIcons(isDark) {
            document.getElementById('theme-toggle-dark-icon').classList.toggle('hidden', isDark);
            document.getElementById('theme-toggle-light-icon').classList.toggle('hidden', !isDark);
        }

        // Tabs Navigation
        function switchTab(tabId) {
            ['dashboard', 'students', 'ranking', 'conduct', 'attendance'].forEach(tab => {
                const view = document.getElementById(`view-${tab}`);
                const desktopBtn = document.getElementById(`tab-btn-${tab}`);
                const mobileBtn = document.getElementById(`mobile-tab-${tab}`);

                if (tab === tabId) {
                    view.classList.remove('hidden');
                    desktopBtn.className = "px-3 py-2 rounded-lg text-sm font-semibold transition flex items-center space-x-2 bg-sky-50 dark:bg-slate-700 text-sky-600 dark:text-sky-400";
                    if (mobileBtn) mobileBtn.className = "flex flex-col items-center px-1 py-1 text-sky-600 font-semibold";
                } else {
                    view.classList.add('hidden');
                    desktopBtn.className = "px-3 py-2 rounded-lg text-sm font-medium transition flex items-center space-x-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700";
                    if (mobileBtn) mobileBtn.className = "flex flex-col items-center px-1 py-1 text-slate-500 dark:text-slate-400";
                }
            });

            renderAll();
        }

        function renderAll() {
            renderDashboard();
            renderStudentsTable();
            renderWeeklyGroupRankings();
            renderRankingTable();
            renderMonthlyConductTable();
            loadAttendanceForDate();
        }

        // Dashboard Render
        function renderDashboard() {
            const total = students.length;
            const male = students.filter(s => s.gender === 'Nam').length;
            const female = students.filter(s => s.gender === 'Nữ').length;
            const kinh = students.filter(s => s.ethnicity === 'Kinh').length;
            const khmer = students.filter(s => s.ethnicity === 'Khmer').length;

            document.getElementById('stat-total').innerText = total;
            document.getElementById('stat-male').innerText = male;
            document.getElementById('stat-female').innerText = female;
            document.getElementById('stat-gender-ratio').innerText = total > 0 ? `${Math.round((male/total)*100)}% Nam / ${Math.round((female/total)*100)}% Nữ` : '---';
            document.getElementById('stat-kinh').innerText = kinh;
            document.getElementById('stat-khmer').innerText = khmer;

            const numericScores = students.map(s => parseFloat(s.score)).filter(val => !isNaN(val));
            const avgEntrance = numericScores.length > 0 ? (numericScores.reduce((a, b) => a + b, 0) / numericScores.length).toFixed(2) : '0';
            document.getElementById('stat-avg-entrance').innerText = avgEntrance;

            // 5 Groups Breakdown
            const groups = ['Tổ 1', 'Tổ 2', 'Tổ 3', 'Tổ 4', 'Tổ 5'];
            document.getElementById('group-stats-container').innerHTML = groups.map(g => {
                const count = students.filter(s => s.group === g).length;
                return `
                    <div class="bg-slate-50 dark:bg-slate-900/80 p-3 rounded-xl border border-slate-200 dark:border-slate-700 text-center">
                        <span class="text-xs font-semibold text-slate-500">${g}</span>
                        <h4 class="text-xl font-bold text-sky-600 dark:text-sky-400">${count}</h4>
                        <span class="text-[10px] text-slate-400">học sinh</span>
                    </div>
                `;
            }).join('');

            // Academic Breakdown
            const academicTypes = ['Chưa xếp loại', 'Xuất sắc', 'Giỏi', 'Khá', 'Đạt', 'Chưa đạt'];
            document.getElementById('academic-stats-container').innerHTML = academicTypes.map(ac => {
                const count = students.filter(s => s.academic === ac).length;
                const pct = total > 0 ? Math.round((count / total) * 100) : 0;
                return `
                    <div>
                        <div class="flex justify-between text-xs font-medium mb-1">
                            <span>${ac}</span>
                            <span class="text-slate-500">${count} HS (${pct}%)</span>
                        </div>
                        <div class="w-full h-2 bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden">
                            <div class="bg-sky-500 h-full rounded-full transition-all duration-300" style="width: ${pct}%"></div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Students Table Render
        function renderStudentsTable() {
            const tbody = document.getElementById('student-table-body');
            const emptyState = document.getElementById('empty-state');
            
            const search = document.getElementById('search-input').value.toLowerCase().trim();
            const groupFilter = document.getElementById('filter-group').value;
            const academicFilter = document.getElementById('filter-academic').value;
            const roleFilter = document.getElementById('filter-role').value;

            const filtered = students.filter(s => {
                const matchesSearch = s.name.toLowerCase().includes(search) || s.school.toLowerCase().includes(search) || s.ethnicity.toLowerCase().includes(search);
                const matchesGroup = !groupFilter || s.group === groupFilter;
                const matchesAcademic = !academicFilter || s.academic === academicFilter;
                const matchesRole = !roleFilter || s.role === roleFilter;
                return matchesSearch && matchesGroup && matchesAcademic && matchesRole;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            tbody.innerHTML = filtered.map((s, index) => `
                <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-700/50 transition">
                    <td class="py-3 px-4 text-center font-medium text-slate-400 text-xs">${index + 1}</td>
                    <td class="py-3 px-4 font-semibold text-slate-900 dark:text-slate-100">${escapeHtml(s.name)}</td>
                    <td class="py-3 px-4 text-xs">${s.gender}</td>
                    <td class="py-3 px-4 text-xs text-slate-600 dark:text-slate-300">${s.dob}</td>
                    <td class="py-3 px-4 text-xs">${s.ethnicity}</td>
                    <td class="py-3 px-4 text-xs text-slate-500">${escapeHtml(s.school)}</td>
                    <td class="py-3 px-4 font-medium text-xs ${s.score === 'T.Thắng' ? 'text-amber-600' : 'text-sky-600'}">${s.score}</td>
                    <td class="py-3 px-4 text-xs font-semibold text-slate-700 dark:text-slate-200">${s.group}</td>
                    <td class="py-3 px-4 text-xs"><span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-700 font-medium">${s.role}</span></td>
                    <td class="py-3 px-4 text-xs"><span class="px-2 py-0.5 rounded-md ${s.academic === 'Chưa xếp loại' ? 'bg-slate-100 text-slate-500' : 'bg-emerald-100 text-emerald-700'}">${s.academic}</span></td>
                    <td class="py-3 px-4 text-center">
                        <div class="flex items-center justify-center space-x-2">
                            <button onclick="openEditModal('${s.id}')" title="Sửa" class="p-1.5 text-slate-400 hover:text-sky-600 transition"><i class="fa-solid fa-pen-to-square"></i></button>
                            <button onclick="deleteStudent('${s.id}')" title="Xóa" class="p-1.5 text-slate-400 hover:text-rose-600 transition"><i class="fa-solid fa-trash-can"></i></button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        // Weekly 5 Groups Rankings Render
        function renderWeeklyGroupRankings() {
            const selectedWeek = document.getElementById('selected-week').value;
            document.getElementById('weekly-ranking-title').innerText = `Bảng Xếp Hạng Thi Đua 5 Tổ (${selectedWeek})`;

            const container = document.getElementById('group-ranking-cards');
            const groupList = ['Tổ 1', 'Tổ 2', 'Tổ 3', 'Tổ 4', 'Tổ 5'];

            const weekData = weeklyGroupPoints[selectedWeek] || { 'Tổ 1': 100, 'Tổ 2': 100, 'Tổ 3': 100, 'Tổ 4': 100, 'Tổ 5': 100 };

            const groupStats = groupList.map(gName => {
                const members = students.filter(s => s.group === gName);
                const count = members.length;
                const points = weekData[gName] !== undefined ? weekData[gName] : 100;
                
                const gpaList = members.map(m => m.gpa).filter(v => v > 0);
                const avgGpa = gpaList.length > 0 ? (gpaList.reduce((a,b)=>a+b, 0) / gpaList.length).toFixed(1) : '---';

                return { name: gName, count, points, avgGpa };
            });

            // Sort Groups by Points descending
            groupStats.sort((a, b) => b.points - a.points);

            const badgeStyles = [
                { badge: 'bg-amber-400 text-slate-900', rankText: 'HẠNG 1', icon: 'fa-trophy text-amber-500' },
                { badge: 'bg-slate-300 text-slate-900', rankText: 'HẠNG 2', icon: 'fa-medal text-slate-400' },
                { badge: 'bg-amber-600 text-white', rankText: 'HẠNG 3', icon: 'fa-award text-amber-600' },
                { badge: 'bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300', rankText: 'HẠNG 4', icon: 'fa-flag text-slate-400' },
                { badge: 'bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300', rankText: 'HẠNG 5', icon: 'fa-flag text-slate-400' }
            ];

            container.innerHTML = groupStats.map((item, idx) => `
                <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm relative overflow-hidden">
                    <div class="flex justify-between items-start mb-3">
                        <span class="text-xs font-bold px-2.5 py-1 rounded-full ${badgeStyles[idx].badge}">${badgeStyles[idx].rankText}</span>
                        <i class="fa-solid ${badgeStyles[idx].icon} text-2xl"></i>
                    </div>
                    <h4 class="text-xl font-bold mb-1">${item.name}</h4>
                    <p class="text-xs text-slate-500 mb-4">Sĩ số: ${item.count} học sinh</p>
                    <div class="pt-3 border-t border-slate-100 dark:border-slate-700/60 flex justify-between items-center text-xs">
                        <span class="text-slate-500">Điểm Thi Đua:</span>
                        <span class="text-lg font-extrabold text-sky-600 dark:text-sky-400">${item.points} pt</span>
                    </div>
                    <div class="mt-1 flex justify-between items-center text-xs">
                        <span class="text-slate-500">ĐTB Học Tập Tổ:</span>
                        <span class="font-bold text-slate-700 dark:text-slate-300">${item.avgGpa}</span>
                    </div>
                </div>
            `).join('');
        }

        // Student Ranking Table Render
        function renderRankingTable() {
            const tbody = document.getElementById('ranking-table-body');
            const sortBy = document.getElementById('sort-ranking-by').value;

            let sorted = [...students];

            if (sortBy === 'entrance') {
                sorted.sort((a, b) => {
                    const scoreA = parseFloat(a.score) || 0;
                    const scoreB = parseFloat(b.score) || 0;
                    return scoreB - scoreA;
                });
            } else if (sortBy === 'gpa') {
                sorted.sort((a, b) => b.gpa - a.gpa);
            }

            tbody.innerHTML = sorted.map((s, index) => {
                let rankBadge = `<span class="text-slate-500 font-bold text-xs">${index + 1}</span>`;
                if (index === 0) rankBadge = `<span class="w-6 h-6 rounded-full bg-amber-400 text-slate-900 font-extrabold text-xs flex items-center justify-center mx-auto">1</span>`;
                else if (index === 1) rankBadge = `<span class="w-6 h-6 rounded-full bg-slate-300 text-slate-900 font-extrabold text-xs flex items-center justify-center mx-auto">2</span>`;
                else if (index === 2) rankBadge = `<span class="w-6 h-6 rounded-full bg-amber-600 text-white font-extrabold text-xs flex items-center justify-center mx-auto">3</span>`;

                return `
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition">
                        <td class="py-3 px-4 text-center">${rankBadge}</td>
                        <td class="py-3 px-4 font-semibold">${escapeHtml(s.name)}</td>
                        <td class="py-3 px-4 text-xs">${s.group}</td>
                        <td class="py-3 px-4 text-xs font-bold text-sky-600">${s.score}</td>
                        <td class="py-3 px-4 text-xs font-semibold">${s.gpa > 0 ? s.gpa : '---'}</td>
                        <td class="py-3 px-4 text-xs">${s.academic}</td>
                    </tr>
                `;
            }).join('');
        }

        // Monthly Conduct Table Render
        function renderMonthlyConductTable() {
            const tbody = document.getElementById('conduct-table-body');
            const selectedMonth = document.getElementById('selected-month').value;
            const monthData = monthlyConducts[selectedMonth] || {};

            tbody.innerHTML = students.map((s, idx) => {
                const conduct = monthData[s.id] || { score: 100, rating: 'Tốt' };

                let ratingBadgeClass = 'bg-emerald-100 text-emerald-700';
                if (conduct.rating === 'Khá') ratingBadgeClass = 'bg-sky-100 text-sky-700';
                else if (conduct.rating === 'Đạt') ratingBadgeClass = 'bg-amber-100 text-amber-700';
                else if (conduct.rating === 'Chưa đạt') ratingBadgeClass = 'bg-rose-100 text-rose-700';

                return `
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition">
                        <td class="py-3 px-4 text-center text-xs text-slate-400 font-medium">${idx + 1}</td>
                        <td class="py-3 px-4 font-semibold text-slate-900 dark:text-slate-100">${escapeHtml(s.name)}</td>
                        <td class="py-3 px-4 text-xs text-slate-500">${s.group}</td>
                        <td class="py-3 px-4 text-xs font-bold text-sky-600">${conduct.score} điểm</td>
                        <td class="py-3 px-4 text-xs"><span class="px-2.5 py-1 rounded-md font-bold ${ratingBadgeClass}">${conduct.rating}</span></td>
                        <td class="py-3 px-4 text-center">
                            <button onclick="openConductModal('${s.id}')" class="px-3 py-1 bg-slate-100 dark:bg-slate-700 hover:bg-sky-50 dark:hover:bg-slate-600 text-sky-600 dark:text-sky-400 rounded-lg text-xs font-medium transition">
                                <i class="fa-solid fa-pen-to-square mr-1"></i> Sửa Hạnh Kiểm
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Attendance Loader
        function loadAttendanceForDate() {
            const dateStr = document.getElementById('attendance-date').value;
            if (!dateStr) return;

            const tbody = document.getElementById('attendance-table-body');
            const dayRecord = attendanceRecords[dateStr] || {};
            let counts = { Present: 0, Excused: 0, Unexcused: 0, Late: 0 };

            tbody.innerHTML = students.map((s, idx) => {
                const status = dayRecord[s.id] || 'Present';
                counts[status] = (counts[status] || 0) + 1;

                return `
                    <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-700/50 transition">
                        <td class="py-3 px-4 text-center font-medium text-slate-400 text-xs">${idx + 1}</td>
                        <td class="py-3 px-4 font-semibold text-xs">${escapeHtml(s.name)}</td>
                        <td class="py-3 px-4 text-xs text-slate-500">${s.group}</td>
                        <td class="py-3 px-4">
                            <div class="flex items-center justify-center space-x-3 text-xs">
                                <label class="inline-flex items-center cursor-pointer space-x-1">
                                    <input type="radio" name="att-${s.id}" value="Present" ${status === 'Present' ? 'checked' : ''} onchange="updateTempAttStats()" class="text-emerald-600">
                                    <span class="text-emerald-700 dark:text-emerald-400 font-medium">Hiện diện</span>
                                </label>
                                <label class="inline-flex items-center cursor-pointer space-x-1">
                                    <input type="radio" name="att-${s.id}" value="Excused" ${status === 'Excused' ? 'checked' : ''} onchange="updateTempAttStats()" class="text-amber-600">
                                    <span class="text-amber-700 dark:text-amber-400 font-medium">Có phép</span>
                                </label>
                                <label class="inline-flex items-center cursor-pointer space-x-1">
                                    <input type="radio" name="att-${s.id}" value="Unexcused" ${status === 'Unexcused' ? 'checked' : ''} onchange="updateTempAttStats()" class="text-rose-600">
                                    <span class="text-rose-700 dark:text-rose-400 font-medium">Không phép</span>
                                </label>
                                <label class="inline-flex items-center cursor-pointer space-x-1">
                                    <input type="radio" name="att-${s.id}" value="Late" ${status === 'Late' ? 'checked' : ''} onchange="updateTempAttStats()" class="text-sky-600">
                                    <span class="text-sky-700 dark:text-sky-400 font-medium">Đi trễ</span>
                                </label>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');

            updateAttCounters(counts);
        }

        function updateTempAttStats() {
            let counts = { Present: 0, Excused: 0, Unexcused: 0, Late: 0 };
            students.forEach(s => {
                const checkedRadio = document.querySelector(`input[name="att-${s.id}"]:checked`);
                if (checkedRadio) counts[checkedRadio.value] = (counts[checkedRadio.value] || 0) + 1;
            });
            updateAttCounters(counts);
        }

        function updateAttCounters(counts) {
            document.getElementById('att-count-present').innerText = counts.Present || 0;
            document.getElementById('att-count-excused').innerText = counts.Excused || 0;
            document.getElementById('att-count-unexcused').innerText = counts.Unexcused || 0;
            document.getElementById('att-count-late').innerText = counts.Late || 0;
        }

        function saveAttendance() {
            const dateStr = document.getElementById('attendance-date').value;
            if (!dateStr) return;

            const dayRecord = {};
            students.forEach(s => {
                const checkedRadio = document.querySelector(`input[name="att-${s.id}"]:checked`);
                if (checkedRadio) dayRecord[s.id] = checkedRadio.value;
            });

            attendanceRecords[dateStr] = dayRecord;
            saveAttendanceToStorage();
            showToast(`Đã lưu điểm danh ngày ${dateStr}!`);
        }

        // Student Modal Actions
        function openAddModal() {
            document.getElementById('modal-title').innerText = 'Thêm Học sinh mới (10.10)';
            document.getElementById('student-id').value = '';
            document.getElementById('student-form').reset();
            document.getElementById('form-group').value = 'Tổ 1';
            document.getElementById('form-academic').value = 'Chưa xếp loại';
            document.getElementById('student-modal').classList.remove('hidden');
        }

        function openEditModal(id) {
            const s = students.find(item => item.id === id);
            if (!s) return;

            document.getElementById('modal-title').innerText = 'Chỉnh sửa Học sinh';
            document.getElementById('student-id').value = s.id;
            document.getElementById('form-name').value = s.name;
            document.getElementById('form-gender').value = s.gender;
            document.getElementById('form-dob').value = s.dob;
            document.getElementById('form-ethnicity').value = s.ethnicity;
            document.getElementById('form-school').value = s.school;
            document.getElementById('form-score').value = s.score;
            document.getElementById('form-group').value = s.group || 'Tổ 1';
            document.getElementById('form-role').value = s.role || 'Thành viên';
            document.getElementById('form-gpa').value = s.gpa || '';
            document.getElementById('form-academic').value = s.academic || 'Chưa xếp loại';

            document.getElementById('student-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('student-modal').classList.add('hidden');
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('student-id').value;
            const name = document.getElementById('form-name').value.trim();
            const gender = document.getElementById('form-gender').value;
            const dob = document.getElementById('form-dob').value.trim();
            const ethnicity = document.getElementById('form-ethnicity').value.trim();
            const school = document.getElementById('form-school').value.trim();
            const score = document.getElementById('form-score').value.trim();
            const group = document.getElementById('form-group').value;
            const role = document.getElementById('form-role').value;
            const gpa = parseFloat(document.getElementById('form-gpa').value) || 0;
            const academic = document.getElementById('form-academic').value;

            if (id) {
                const index = students.findIndex(s => s.id === id);
                if (index !== -1) {
                    students[index] = { id, name, gender, dob, ethnicity, school, score, group, role, gpa, academic };
                    showToast('Đã cập nhật thông tin học sinh!');
                }
            } else {
                const newId = Date.now().toString();
                students.push({ id: newId, name, gender, dob, ethnicity, school, score, group, role, gpa, academic });
                showToast('Đã thêm học sinh mới!');
            }

            saveStudentsToStorage();
            closeModal();
            renderAll();
        }

        function deleteStudent(id) {
            const student = students.find(s => s.id === id);
            if (!student) return;

            if (confirm(`Bạn có chắc chắn muốn xóa học sinh "${student.name}" khỏi danh sách lớp 10.10?`)) {
                students = students.filter(s => s.id !== id);
                saveStudentsToStorage();
                renderAll();
                showToast('Đã xóa học sinh khỏi danh sách.');
            }
        }

        // Weekly Group Points Modal Actions
        function openGroupPointsModal() {
            const selectedWeek = document.getElementById('selected-week').value;
            document.getElementById('modal-weekly-title').innerText = `Cập Nhật Điểm Thi Đua 5 Tổ (${selectedWeek})`;
            
            const weekData = weeklyGroupPoints[selectedWeek] || { 'Tổ 1': 100, 'Tổ 2': 100, 'Tổ 3': 100, 'Tổ 4': 100, 'Tổ 5': 100 };
            document.getElementById('gp-1').value = weekData['Tổ 1'] !== undefined ? weekData['Tổ 1'] : 100;
            document.getElementById('gp-2').value = weekData['Tổ 2'] !== undefined ? weekData['Tổ 2'] : 100;
            document.getElementById('gp-3').value = weekData['Tổ 3'] !== undefined ? weekData['Tổ 3'] : 100;
            document.getElementById('gp-4').value = weekData['Tổ 4'] !== undefined ? weekData['Tổ 4'] : 100;
            document.getElementById('gp-5').value = weekData['Tổ 5'] !== undefined ? weekData['Tổ 5'] : 100;

            document.getElementById('group-points-modal').classList.remove('hidden');
        }

        function closeGroupPointsModal() {
            document.getElementById('group-points-modal').classList.add('hidden');
        }

        function saveWeeklyGroupPoints() {
            const selectedWeek = document.getElementById('selected-week').value;

            weeklyGroupPoints[selectedWeek] = {
                'Tổ 1': parseInt(document.getElementById('gp-1').value) || 0,
                'Tổ 2': parseInt(document.getElementById('gp-2').value) || 0,
                'Tổ 3': parseInt(document.getElementById('gp-3').value) || 0,
                'Tổ 4': parseInt(document.getElementById('gp-4').value) || 0,
                'Tổ 5': parseInt(document.getElementById('gp-5').value) || 0
            };

            saveWeeklyPointsToStorage();
            closeGroupPointsModal();
            renderWeeklyGroupRankings();
            showToast(`Đã lưu điểm thi đua 5 Tổ cho ${selectedWeek}!`);
        }

        // Monthly Student Conduct Modal Actions
        function openConductModal(studentId) {
            const student = students.find(s => s.id === studentId);
            if (!student) return;

            const selectedMonth = document.getElementById('selected-month').value;
            const monthData = monthlyConducts[selectedMonth] || {};
            const conduct = monthData[studentId] || { score: 100, rating: 'Tốt' };

            document.getElementById('conduct-student-id').value = studentId;
            document.getElementById('modal-conduct-student-name').innerText = `Hạnh Kiểm: ${student.name}`;
            document.getElementById('conduct-month-display').value = selectedMonth;
            document.getElementById('conduct-score-input').value = conduct.score;
            document.getElementById('conduct-rating-input').value = conduct.rating;

            document.getElementById('student-conduct-modal').classList.remove('hidden');
        }

        function closeConductModal() {
            document.getElementById('student-conduct-modal').classList.add('hidden');
        }

        function saveStudentConduct() {
            const studentId = document.getElementById('conduct-student-id').value;
            const selectedMonth = document.getElementById('selected-month').value;
            const score = parseInt(document.getElementById('conduct-score-input').value) || 0;
            const rating = document.getElementById('conduct-rating-input').value;

            if (!monthlyConducts[selectedMonth]) {
                monthlyConducts[selectedMonth] = {};
            }

            monthlyConducts[selectedMonth][studentId] = { score, rating };

            saveMonthlyConductsToStorage();
            closeConductModal();
            renderMonthlyConductTable();
            showToast(`Đã lưu hạnh kiểm ${selectedMonth}!`);
        }

        // Export CSV
        function exportToCSV() {
            if (students.length === 0) {
                showToast('Không có dữ liệu!');
                return;
            }

            let csvContent = "\uFEFF"; 
            csvContent += "STT,Họ và Tên,Giới tính,Ngày sinh,Dân tộc,Trường THCS cũ,Điểm TS,Tổ,Chức vụ,ĐTB Học tập,Học lực\n";

            students.forEach((s, idx) => {
                const row = [
                    idx + 1,
                    `"${s.name.replace(/"/g, '""')}"`,
                    s.gender,
                    s.dob,
                    s.ethnicity,
                    `"${s.school}"`,
                    `"${s.score}"`,
                    `"${s.group}"`,
                    `"${s.role}"`,
                    s.gpa,
                    `"${s.academic}"`
                ];
                csvContent += row.join(",") + "\n";
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = `Danh_Sach_Lop_10_10_Dương_Quang_Đông.csv`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast('Đã xuất file CSV thành công!');
        }

        // Helper Utilities
        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return (text || '').replace(/[&<>"']/g, m => map[m]);
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 3000);
        }
    </script>
</body>
</html>


