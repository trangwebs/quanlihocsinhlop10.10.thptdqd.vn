<!DOCTYPE html>
<html lang="vi" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Học sinh Lớp 10.10 - THPT Dương Quang Đông</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Font: Inter -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <style>
        body { font-family: 'Inter', sans-serif; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 transition-colors duration-200 min-h-screen flex flex-col">

    <!-- HEADER / TOP NAVBAR -->
    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo & Title -->
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-600 to-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-md">
                        10.10
                    </div>
                    <div>
                        <h1 class="text-base font-bold bg-gradient-to-r from-sky-600 to-indigo-600 dark:from-sky-400 dark:to-indigo-400 bg-clip-text text-transparent">
                            THPT DƯƠNG QUANG ĐÔNG
                        </h1>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Lớp 10.10 • Năm học 2026 - 2027</p>
                    </div>
                </div>

                <!-- Navigation Tabs (Desktop) -->
                <nav class="hidden md:flex space-x-1">
                    <button onclick="switchTab('dashboard')" id="tab-btn-dashboard" class="px-3 py-2 rounded-lg text-sm font-medium transition flex items-center space-x-2 bg-sky-50 dark:bg-slate-700 text-sky-600 dark:text-sky-400">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Tổng quan</span>
                    </button>
                    <button onclick="switchTab('students')" id="tab-btn-students" class="px-3 py-2 rounded-lg text-sm font-medium transition flex items-center space-x-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
                        <i class="fa-solid fa-users"></i>
                        <span>Danh sách (45 HS)</span>
                    </button>
                    <button onclick="switchTab('ranking')" id="tab-btn-ranking" class="px-3 py-2 rounded-lg text-sm font-medium transition flex items-center space-x-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
                        <i class="fa-solid fa-trophy"></i>
                        <span>Thi Đua 5 Tổ</span>
                    </button>
                    <button onclick="switchTab('conduct')" id="tab-btn-conduct" class="px-3 py-2 rounded-lg text-sm font-medium transition flex items-center space-x-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
                        <i class="fa-solid fa-id-card-clip"></i>
                        <span>Hạnh Kiểm Tháng</span>
                    </button>
                    <button onclick="switchTab('attendance')" id="tab-btn-attendance" class="px-3 py-2 rounded-lg text-sm font-medium transition flex items-center space-x-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
                        <i class="fa-solid fa-clipboard-user"></i>
                        <span>Điểm danh</span>
                    </button>
                </nav>

                <!-- Action Tools -->
                <div class="flex items-center space-x-2">
                    <button onclick="exportToCSV()" title="Xuất dữ liệu CSV" class="hidden sm:inline-flex items-center space-x-1 px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 text-xs font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                        <i class="fa-solid fa-file-csv text-green-600 dark:text-green-400 text-sm"></i>
                        <span>Xuất CSV</span>
                    </button>
                    <button onclick="confirmResetData()" title="Khôi phục danh sách 45 học sinh chuẩn" class="p-2 rounded-lg text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                        <i class="fa-solid fa-rotate-right"></i>
                    </button>
                    <button onclick="toggleDarkMode()" id="theme-toggle" class="p-2 rounded-lg text-slate-500 hover:text-amber-500 dark:text-slate-400 dark:hover:text-amber-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                        <i class="fa-solid fa-moon text-lg" id="theme-toggle-dark-icon"></i>
                        <i class="fa-solid fa-sun text-lg hidden" id="theme-toggle-light-icon"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Bar -->
        <div class="md:hidden flex justify-around border-t border-slate-200 dark:border-slate-700 py-2 bg-white dark:bg-slate-800 text-[11px]">
            <button onclick="switchTab('dashboard')" id="mobile-tab-dashboard" class="flex flex-col items-center px-1 py-1 text-sky-600 font-semibold">
                <i class="fa-solid fa-chart-pie text-sm mb-0.5"></i>
                <span>Tổng quan</span>
            </button>
            <button onclick="switchTab('students')" id="mobile-tab-students" class="flex flex-col items-center px-1 py-1 text-slate-500 dark:text-slate-400">
                <i class="fa-solid fa-users text-sm mb-0.5"></i>
                <span>Danh sách</span>
            </button>
            <button onclick="switchTab('ranking')" id="mobile-tab-ranking" class="flex flex-col items-center px-1 py-1 text-slate-500 dark:text-slate-400">
                <i class="fa-solid fa-trophy text-sm mb-0.5"></i>
                <span>Thi Đua Tổ</span>
            </button>
            <button onclick="switchTab('conduct')" id="mobile-tab-conduct" class="flex flex-col items-center px-1 py-1 text-slate-500 dark:text-slate-400">
                <i class="fa-solid fa-id-card-clip text-sm mb-0.5"></i>
                <span>Hạnh kiểm</span>
            </button>
            <button onclick="switchTab('attendance')" id="mobile-tab-attendance" class="flex flex-col items-center px-1 py-1 text-slate-500 dark:text-slate-400">
                <i class="fa-solid fa-clipboard-user text-sm mb-0.5"></i>
                <span>Điểm danh</span>
            </button>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- TAB 1: DASHBOARD -->
        <section id="view-dashboard" class="space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight">Tổng Quan Lớp 10.10</h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400">GVCN: <span class="font-semibold text-slate-700 dark:text-slate-200">Phạm Thị Thanh Tuyền</span> • Đã chia làm <span class="font-bold text-sky-600">5 Tổ</span></p>
                </div>
                <button onclick="openAddModal()" class="px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white rounded-xl shadow-sm text-sm font-medium flex items-center space-x-2 transition">
                    <i class="fa-solid fa-plus"></i>
                    <span>Thêm học sinh</span>
                </button>
            </div>

            <!-- Stats Overview Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-sky-100 dark:bg-sky-900/40 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">Tổng sĩ số</p>
                        <h3 class="text-2xl font-bold mt-0.5" id="stat-total">45</h3>
                        <p class="text-xs text-slate-500 mt-1">Đã chia vào 5 Tổ</p>
                    </div>
                </div>

                <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-pink-100 dark:bg-pink-900/40 text-pink-600 dark:text-pink-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-venus-mars"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">Tỷ lệ Giới tính</p>
                        <h3 class="text-xl font-bold mt-0.5"><span id="stat-male" class="text-blue-500">0</span> Nam / <span id="stat-female" class="text-pink-500">0</span> Nữ</h3>
                        <p class="text-xs text-slate-500 mt-1" id="stat-gender-ratio">---</p>
                    </div>
                </div>

                <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-people-group"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">Dân tộc</p>
                        <h3 class="text-lg font-bold mt-0.5"><span id="stat-kinh">0</span> Kinh / <span id="stat-khmer" class="text-amber-600">0</span> Khmer</h3>
                        <p class="text-xs text-slate-500 mt-1">Lớp học hòa nhập</p>
                    </div>
                </div>

                <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-medal"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">Điểm Tuyển Sinh ĐTB</p>
                        <h3 class="text-2xl font-bold mt-0.5" id="stat-avg-entrance">18.02</h3>
                        <p class="text-xs text-emerald-600 font-medium mt-1">Đánh giá ban đầu</p>
                    </div>
                </div>
            </div>

            <!-- Detailed Breakdown -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Group Member Count Card -->
                <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                    <h3 class="font-bold text-base flex items-center space-x-2">
                        <i class="fa-solid fa-layer-group text-sky-500"></i>
                        <span>Phân bổ Học sinh theo 5 Tổ</span>
                    </h3>
                    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 pt-2" id="group-stats-container">
                        <!-- Injected via JS -->
                    </div>
                </div>

                <!-- Academic Performance Status Card -->
                <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                    <h3 class="font-bold text-base flex items-center space-x-2">
                        <i class="fa-solid fa-graduation-cap text-indigo-500"></i>
                        <span>Phân loại Học lực Lớp</span>
                    </h3>
                    <div class="space-y-3 pt-1" id="academic-stats-container">
                        <!-- Injected via JS -->
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: STUDENTS LIST -->
        <section id="view-students" class="hidden space-y-5">
            <!-- Search & Filters -->
            <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col md:flex-row gap-3 items-center justify-between">
                <div class="relative w-full md:w-72">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                    <input type="text" id="search-input" oninput="renderStudentsTable()" placeholder="Tìm tên, trường cũ, dân tộc..." class="w-full pl-10 pr-4 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-sky-500">
                </div>

                <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
                    <!-- Filter Group -->
                    <select id="filter-group" onchange="renderStudentsTable()" class="px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-xs font-medium text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500">
                        <option value="">Tất cả 5 Tổ</option>
                        <option value="Tổ 1">Tổ 1</option>
                        <option value="Tổ 2">Tổ 2</option>
                        <option value="Tổ 3">Tổ 3</option>
                        <option value="Tổ 4">Tổ 4</option>
                        <option value="Tổ 5">Tổ 5</option>
                    </select>

                    <!-- Filter Academic -->
                    <select id="filter-academic" onchange="renderStudentsTable()" class="px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-xs font-medium text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500">
                        <option value="">Tất cả Học lực</option>
                        <option value="Chưa xếp loại">Chưa xếp loại</option>
                        <option value="Xuất sắc">Xuất sắc</option>
                        <option value="Giỏi">Giỏi</option>
                        <option value="Khá">Khá</option>
                        <option value="Đạt">Đạt</option>
                        <option value="Chưa đạt">Chưa đạt</option>
                    </select>

                    <!-- Filter Role -->
                    <select id="filter-role" onchange="renderStudentsTable()" class="px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-xs font-medium text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500">
                        <option value="">Tất cả Chức vụ</option>
                        <option value="Lớp trưởng">Lớp trưởng</option>
                        <option value="Lớp phó học tập">Lớp phó học tập</option>
                        <option value="Lớp phó phong trào">Lớp phó phong trào</option>
                        <option value="Tổ trưởng Tổ 1">Tổ trưởng Tổ 1</option>
                        <option value="Tổ trưởng Tổ 2">Tổ trưởng Tổ 2</option>
                        <option value="Tổ trưởng Tổ 3">Tổ trưởng Tổ 3</option>
                        <option value="Tổ trưởng Tổ 4">Tổ trưởng Tổ 4</option>
                        <option value="Tổ trưởng Tổ 5">Tổ trưởng Tổ 5</option>
                        <option value="Thành viên">Thành viên</option>
                    </select>

                    <button onclick="openAddModal()" class="ml-auto px-3.5 py-2 bg-sky-600 hover:bg-sky-700 text-white rounded-xl shadow-sm text-xs font-medium flex items-center space-x-1.5 transition">
                        <i class="fa-solid fa-plus"></i>
                        <span>Thêm mới</span>
                    </button>
                </div>
            </div>

            <!-- Table -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 dark:bg-slate-900/60 border-b border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                                <th class="py-3 px-4 text-center w-12">STT</th>
                                <th class="py-3 px-4">Họ và tên</th>
                                <th class="py-3 px-4">Giới tính</th>
                                <th class="py-3 px-4">Ngày sinh</th>
                                <th class="py-3 px-4">Dân tộc</th>
                                <th class="py-3 px-4">Trường THCS cũ</th>
                                <th class="py-3 px-4">Điểm TS</th>
                                <th class="py-3 px-4">Tổ</th>
                                <th class="py-3 px-4">Chức vụ</th>
                                <th class="py-3 px-4">Học lực</th>
                                <th class="py-3 px-4 text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="student-table-body" class="divide-y divide-slate-200 dark:divide-slate-700 text-sm">
                            <!-- Injected by JS -->
                        </tbody>
                    </table>
                </div>
                <div id="empty-state" class="hidden py-12 text-center space-y-3">
                    <p class="text-slate-500">Không tìm thấy học sinh phù hợp.</p>
                </div>
            </div>
        </section>

        <!-- TAB 3: THI ĐUA 5 TỔ THEO TUẦN -->
        <section id="view-ranking" class="hidden space-y-6">
            <!-- Header & Week Selector -->
            <div class="bg-gradient-to-r from-sky-600 to-indigo-600 rounded-2xl p-6 text-white shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div>
                    <h2 class="text-xl font-bold flex items-center space-x-2">
                        <i class="fa-solid fa-trophy text-amber-300"></i>
                        <span>Thi Đua 5 Tổ Cập Nhật Theo TUẦN</span>
                    </h2>
                    <p class="text-xs text-sky-100 mt-1">Cập nhật và xếp hạng điểm thi đua tuần cho 5 Tổ trong lớp</p>
                </div>
                
                <div class="flex items-center space-x-3 w-full md:w-auto">
                    <div class="flex items-center space-x-2">
                        <label class="text-xs font-semibold whitespace-nowrap text-sky-100">Chọn Tuần:</label>
                        <select id="selected-week" onchange="renderWeeklyGroupRankings()" class="px-3 py-2 bg-white text-slate-800 rounded-xl text-xs font-bold focus:outline-none">
                            <!-- 35 Weeks generated via JS -->
                        </select>
                    </div>

                    <button onclick="openGroupPointsModal()" class="px-4 py-2 bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold text-xs rounded-xl shadow transition flex items-center space-x-1.5 whitespace-nowrap">
                        <i class="fa-solid fa-pen-to-square"></i>
                        <span>Nhập Điểm Tuần Này</span>
                    </button>
                </div>
            </div>

            <!-- Group Rankings Cards (Weekly) -->
            <div>
                <h3 class="text-lg font-bold mb-3 flex items-center space-x-2">
                    <i class="fa-solid fa-ranking-star text-amber-500"></i>
                    <span id="weekly-ranking-title">Bảng Xếp Hạng Thi Đua 5 Tổ</span>
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4" id="group-ranking-cards">
                    <!-- Injected via JS -->
                </div>
            </div>

            <!-- Student Class Ranking Table -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm p-6 space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                    <h3 class="text-lg font-bold flex items-center space-x-2">
                        <i class="fa-solid fa-award text-indigo-500"></i>
                        <span>Bảng Xếp Hạng Cá Nhân Toàn Lớp</span>
                    </h3>
                    <div class="flex items-center space-x-2 text-xs">
                        <span class="text-slate-500 font-medium">Sắp xếp theo:</span>
                        <select id="sort-ranking-by" onchange="renderRankingTable()" class="px-3 py-1.5 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg font-medium">
                            <option value="entrance">Điểm Tuyển Sinh</option>
                            <option value="gpa">Điểm TB Học Tập (ĐTB)</option>
                        </select>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 dark:bg-slate-900/60 border-b border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                                <th class="py-3 px-4 text-center w-16">Hạng</th>
                                <th class="py-3 px-4">Họ và tên</th>
                                <th class="py-3 px-4">Tổ</th>
                                <th class="py-3 px-4">Điểm Tuyển sinh</th>
                                <th class="py-3 px-4">ĐTB Học tập</th>
                                <th class="py-3 px-4">Học lực</th>
                            </tr>
                        </thead>
                        <tbody id="ranking-table-body" class="divide-y divide-slate-200 dark:divide-slate-700 text-sm">
                            <!-- Injected by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- TAB 4: HẠNH KIỂM CÁ NHÂN THEO THÁNG -->
        <section id="view-conduct" class="hidden space-y-6">
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div>
                    <h2 class="text-xl font-bold flex items-center space-x-2">
                        <i class="fa-solid fa-id-card-clip text-indigo-500"></i>
                        <span>Quản Lý Hạnh Kiểm Cá Nhân Theo THÁNG</span>
                    </h2>
